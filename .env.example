# Advisor API
DATABASE_URL=postgresql://hive_sight_advisor:hive_sight_advisor@localhost:5433/hive_sight_advisor_dev
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
ADVISOR_API_ALLOWED_ORIGINS=http://localhost:5183
# Cosine-distance thresholds for grounding classification (defaults shown; only
# override if you know what you're doing - see decision-log.md, FR-008).
ADVISOR_API_GROUNDED_DISTANCE_THRESHOLD=0.35
ADVISOR_API_PARTIAL_DISTANCE_THRESHOLD=0.55
# Shared-secret header HiveSight must send on /integrations/hivesight/* requests.
ADVISOR_API_HIVESIGHT_SERVICE_KEY=
# Guest query rate limit (defaults shown; see architecture/vertical-slice-0013).
ADVISOR_API_GUEST_RATE_LIMIT=10
ADVISOR_API_GUEST_RATE_LIMIT_WINDOW_SECONDS=3600
# Google OAuth Client ID (public, not a secret) - required audience for verifying
# sign-in tokens. Create one in Google Cloud Console; see
# architecture/vertical-slice-0014-google-oidc-sign-in.md's Preconditions.
ADVISOR_API_GOOGLE_CLIENT_ID=

# Web
VITE_ADVISOR_API_URL=http://localhost:8010
VITE_GOOGLE_CLIENT_ID=
